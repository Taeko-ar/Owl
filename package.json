{
  "name": "owl",
  "version": "1.1.2",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tauri dev",
    "dev:linux": "GDK_BACKEND=x11 WEBKIT_DISABLE_COMPOSITING_MODE=1 WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "tauri": "tauri",
    "build": "vite build && tauri build",
    "build:exe": "tauri build --no-bundle",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "vitest run --coverage",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier --write .",
    "cargo:check": "cd src-tauri && cargo check",
    "test": "pnpm run cargo:check && pnpm run unit && pnpm run automation",
    "unit": "vitest run",
    "test:watch": "vitest",
    "automation": "playwright test --reporter=list",
    "automation:headed": "playwright test --headed",
    "automation:report": "playwright show-report",
    "automation:ui": "playwright test --ui",
    "check-i18n": "tsx src/i18n/check-translations.ts",
    "check": "pnpm run typecheck && pnpm run lint:fix && pnpm run format && pnpm run check-i18n && pnpm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.7.0",
    "@testing-library/dom": "^8.0.0",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.7",
    "allure-playwright": "^3.9.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.5",
    "jsdom": "^22.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "wait-on": "^8.0.2"
  }
}
