{
  "name": "owl",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "tauri": "tauri",
    "build": "vite build && tauri build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier --write .",
    "test": "npm run unit && npm run automation",
    "unit": "vitest run",
    "test:watch": "vitest",
    "automation": "npx playwright test --reporter=list",
    "automation:headed": "npx playwright test --headed",
    "automation:report": "npx playwright show-report",
    "automation:ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.7.0",
    "@testing-library/dom": "^8.0.0",
    "@types/node": "^20.14.2",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "allure-playwright": "^3.9.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.5",
    "jsdom": "^22.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  }
}