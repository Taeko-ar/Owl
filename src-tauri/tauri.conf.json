{
  "$schema": "https://tauri.app/v1/schemas/tauri.conf.json",
  "productName": "OWL",
  "version": "1.1.0",
  "identifier": "com.owl",
  "build": {
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/Taeko-ar/Owl/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRUJCMkI1RDE2MEEwRDQKUldUVW9HRFJ0YkxyOFZvaXgwU1FmckZ3eUczRzFncXlxaGdPU2JPbTJwdGh0MXIrajNtQlF5d3cK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "OWL",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src blob: data: filesystem: ws: http: https:; script-src 'self' 'unsafe-inline';"
    }
  }
}
