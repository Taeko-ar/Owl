{
  "$schema": "https://tauri.app/v1/schemas/tauri.conf.json",
  "productName": "OWL",
  "version": "1.1.3",
  "identifier": "com.owl",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": "pnpm exec vite build",
    "devUrl": "http://localhost:4173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Taeko-ar/Owl/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRUJCMkI1RDE2MEEwRDQKUldUVW9HRFJ0YkxyOFZvaXgwU1FmckZ3eUczRzFncXlxaGdPU2JPbTJwdGh0MXIrajNtQlF5d3cK"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OWL",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "fullscreen": false,
        "visible": false,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src https://api.curseforge.com https://edge.forgecdn.net https://api.github.com https://github.com https://objects.githubusercontent.com ws://localhost:* http://localhost:*; font-src 'self'"
    }
  }
}
